[Unit]
Description=Symphony tracker scheduler (production on 214)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/root/symphony-e2e/src/python
Environment=HOME=/root
Environment=LANG=C.UTF-8
Environment=LC_ALL=C.UTF-8
Environment=PATH=/root/symphony-e2e/node22/bin:/usr/local/bin:/usr/local/sbin:/usr/bin:/usr/sbin:/sbin:/bin
ExecStart=/root/symphony-e2e/run_api.sh
Restart=always
RestartSec=5
KillMode=mixed
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
