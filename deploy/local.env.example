# Save real values outside the checkout, e.g. D:/symphony-e2e/env.
LINEAR_API_KEY=
LINEAR_PROJECT_SLUG=
SYMPHONY_REPO=duyiliu/symphony-e2e
# Optional: otherwise the local launcher uses gh auth token on the host.
SYMPHONY_GITHUB_TOKEN=

# May live in a separate ignored file passed with -OAuthEnvFile.
LINEAR_OAUTH_CLIENT_ID=
LINEAR_OAUTH_CLIENT_SECRET=
