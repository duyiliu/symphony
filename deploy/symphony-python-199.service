[Unit]
Description=Symphony agent orchestrator (Python implementation, pi runtime)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/symphony-src/python
EnvironmentFile=/root/symphony/env
Environment=HOME=/root
Environment=LANG=C.UTF-8
Environment=LC_ALL=C.UTF-8
Environment=PATH=/usr/local/bin:/usr/local/sbin:/usr/bin:/usr/sbin:/sbin:/bin
# WORKFLOW.md 路径与 Elixir 版保持一致；端口由文件内 server.port 提供 (8320)。
ExecStart=/usr/bin/python3 -m symphony --workflow /root/symphony/config/WORKFLOW.md
Restart=always
RestartSec=5
# pi 子进程与本服务同 cgroup，停止时整棵树一起回收。
KillMode=mixed
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
