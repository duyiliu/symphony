    def rework_request(self, fail_at=None, pr_changes=None, labels=None, existing=None, payload_changes=None):
        issue = {"author_association": "MEMBER", "state": "open", "labels":
                 [{"name": label} for label in (labels if labels is not None else ["agent"])]}
        pr = {"state": "open", "merged": False, "head": {
            "ref": "agent/issue-1", "repo": {"full_name": "example/repo"}}}
        pr.update(pr_changes or {})
        calls = []
        def fake(method, path, token, body=None, **kwargs):
            calls.append((method, path, body))
            if fail_at == len(calls):
                raise TimeoutError("test timeout")
            if method == "GET": return pr if "/pulls/" in path else (existing or [])
            if method == "POST" and path.endswith("/comments"): return {"id": 123, "body": body["body"]}
            return {}
        payload = {"issue": "GH-1", "pr": 2, "comment": "请优化布局",
                   "request_id": "GH-1-2-11111111-1111-1111-1111-111111111111"}
        payload.update(payload_changes or {})
        with patch.object(board, "load_tracker", return_value=("example/repo", "t")), patch.object(
            board, "fetch_issue", return_value=issue
        ), patch.object(board, "github_request", side_effect=fake):
            status, body = self.request("POST", "/api/rework", json.dumps(payload))
        return status, json.loads(body), calls

    def test_rework_posts_feedback_without_changing_execution_labels(self):
        status, result, calls = self.rework_request()
        self.assertEqual(status, 200)
        self.assertEqual(result["comment_id"], 123)
        self.assertEqual([(m, p) for m, p, _ in calls], [
            ("GET", "/repos/example/repo/pulls/2"),
            ("GET", "/repos/example/repo/issues/2/comments?per_page=100&page=1"),
            ("POST", "/repos/example/repo/issues/2/comments"),
            ("DELETE", "/repos/example/repo/issues/1/labels/merge-approved"),
        ])
        self.assertIn("请优化布局", calls[2][2]["body"])

    def test_rework_during_ai_execution_does_not_start_another_cycle(self):
        with patch.object(board, "agent_detail", return_value={"GH-1": {"session_id": "running"}}):
            status, result, calls = self.rework_request()
        self.assertEqual(status, 200)
        self.assertFalse(any(p.endswith("/labels/agent") or body == {"labels": ["agent"]} for _, p, body in calls))

    def test_rework_keeps_pause_and_only_starts_idle_issue(self):
        for labels in (["needs-human"], ["needs-human", "agent"], []):
            status, result, calls = self.rework_request(labels=labels)
            self.assertEqual(status, 200)
            grants = [body for m, p, body in calls if p.endswith("/labels") and m == "POST"]
            self.assertEqual(grants, [{"labels": ["agent"]}] if not labels else [])
            if labels: self.assertIn("仍暂停", result["message"])

    def test_rework_repeat_request_reuses_comment_and_finishes_revocation(self):
        _, _, calls = self.rework_request()
        existing = {"id": 123, "body": calls[2][2]["body"], "author_association": "OWNER"}
        status, result, repeated = self.rework_request(existing=[existing])
        self.assertEqual(status, 200)
        self.assertEqual(result["comment_id"], 123)
        self.assertFalse(any(m == "POST" for m, _, _ in repeated))
        self.assertEqual(repeated[-1][0], "DELETE")
        status, result, _ = self.rework_request(existing=[existing], payload_changes={"comment": "changed"})
        self.assertEqual(status, 409)

    def test_rework_failures_never_claim_success(self):
        for step in range(1, 5):
            status, result, calls = self.rework_request(fail_at=step)
            self.assertEqual(status, 502)
            self.assertEqual(len(calls), step)
            self.assertEqual(result["outcome"], "not_applied" if step <= 2 else "uncertain" if step == 3 else "partial")
            self.assertFalse(any(body == {"labels": ["agent"]} for _, _, body in calls))

    def test_rework_rejects_closed_merged_and_unrelated_pr_before_writes(self):
        for changes in ({"state": "closed"}, {"merged": True},
                        {"head": {"ref": "agent/issue-99", "repo": {"full_name": "example/repo"}}},
                        {"head": {"ref": "agent/issue-1", "repo": {"full_name": "other/repo"}}}):
            status, result, calls = self.rework_request(pr_changes=changes)
            self.assertEqual(status, 409)
            self.assertEqual(result["outcome"], "not_applied")
            self.assertEqual(len(calls), 1)

    def test_rework_request_id_is_scoped_to_issue_and_pr(self):
        status, result, calls = self.rework_request(payload_changes={"pr": 3})
        self.assertEqual(status, 409)
        self.assertEqual(calls, [])

    def test_rework_requires_valid_feedback(self):
        for comment in ("", "  ", "x" * 1001):
            status, _ = self.request("POST", "/api/rework", json.dumps({"issue": "GH-1", "pr": 2, "comment": comment}))
            self.assertEqual(status, 400)
        self.github_mock.assert_not_called()

    def test_rework_rejects_concurrent_submit_without_writes(self):
        with board._rework_lock:
            status, body = self.request("POST", "/api/rework", json.dumps({"issue": "GH-1", "pr": 2, "comment": "feedback"}))
        self.assertEqual(status, 409)
        self.github_mock.assert_not_called()
